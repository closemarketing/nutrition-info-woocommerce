{
    "name": "closemarketing/nutrition-info-woocommerce",
    "description": "Nutrition Info for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0",
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "wp-coding-standards/wpcs": "^3.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "php-stubs/woocommerce-stubs": "^10.8",
        "yoast/phpunit-polyfills": "^1.0",
        "wp-phpunit/wp-phpunit": "^6.3",
        "yoast/wp-test-utils": "^1.2"
    },
    "scripts": {
        "format": "phpcbf --standard=phpcs.xml.dist",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse --memory-limit=2048M",
        "test": "phpunit",
        "test-install": "bash bin/install-wp-tests.sh wordpress_test root 'root' 127.0.0.1 latest"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.0"
        }
    }
}
